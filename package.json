{
  "name": "emucenter",
  "description": "EmuCenter - emulator and game launcher",
  "author": "Maxsafer",
  "main": "expo-router/entry",
  "version": "3.0.0",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "dist": "expo export --platform web --output-dir web-build && electron-builder"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "electron-serve": "^3.0.0",
    "expo": "~54.0.27",
    "expo-constants": "~18.0.11",
    "expo-font": "~14.0.10",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.10",
    "expo-router": "~6.0.17",
    "expo-splash-screen": "~31.0.12",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.5.1"
  },
  "devDependencies": {
    "@expo/cli": "^54.0.18",
    "@types/react": "~19.1.0",
    "electron": "^39.2.6",
    "electron-builder": "^26.0.12",
    "electron-packager": "^17.1.2",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "typescript": "~5.9.2"
  },
  "build": {
    "appId": "com.emucenter.app",
    "productName": "EmuCenter",
    "asar": false,
    "directories": {
      "output": "release"
    },
    "extraMetadata": {
      "main": "electron-main.js"
    },
    "files": [
      "web-build/**/*",
      "backend/**/*",
      "!backend/config/**",
      "electron-main.js",
      "preload.js",
      "!node_modules/**",
      "node_modules/electron-serve/**",
      "backend/node_modules/**",
      "web-build/assets/node_modules/**"
    ],
    "mac": {
      "category": "public.app-category.games"
    },
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "linux": {
      "target": "AppImage"
    }
  },
  "private": true
}